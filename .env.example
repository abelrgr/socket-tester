# ─── Server ─────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Connection limits ───────────────────────────────────────────────────────
MAX_CONNECTIONS_PER_IP=10
MAX_MESSAGE_SIZE_BYTES=1048576

# ─── Proxy security ──────────────────────────────────────────────────────────
# Comma-separated list of allowed proxy target domains (empty = allow all)
PROXY_URL_ALLOWLIST=

# ─── Rate limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ─── Config sharing (Phase 4) ────────────────────────────────────────────────
SHARE_CONFIG_TTL_SECONDS=604800
